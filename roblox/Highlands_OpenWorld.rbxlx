		</Properties>
		<Item class="Script" referent="RBX4">
			<Properties>
				<ProtectedString name="Source"><![CDATA[
-- HIGHLANDS | Open-world alpine wilderness. Builds once per server session.
-- Terrain API: voxelized 4-stud heightfield; replace/resize via CONFIG.
local Workspace = game:GetService("Workspace")
local Terrain = Workspace.Terrain
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
-- Map is baked into the place at edit time; skip rebuild if terrain already exists.
if Workspace.Terrain:GetAttribute("HighlandsBaked") then return end
local CFG = {seed=24817, radius=256, sea=22, step=4, bottom=-48, forestDensity=0.00042}
local rng = Random.new(CFG.seed)

-- World-scale atmosphere, physically lit materials, restrained post-processing.
Lighting.ClockTime = 16.35
Lighting.Brightness = 2.2
Lighting.ExposureCompensation = 0.05
Lighting.EnvironmentDiffuseScale = 0.42
Lighting.EnvironmentSpecularScale = 0.65
Lighting.Ambient = Color3.fromRGB(92, 103, 112)
Lighting.OutdoorAmbient = Color3.fromRGB(137, 153, 165)
for _,v in ipairs(Lighting:GetChildren()) do if v:IsA("Atmosphere") or v:IsA("Sky") or v:IsA("BloomEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then v:Destroy() end end
local at=Instance.new("Atmosphere"); at.Density=0.27; at.Offset=0.12; at.Color=Color3.fromRGB(190,211,228); at.Decay=Color3.fromRGB(105,130,153); at.Glare=0.18; at.Haze=1.3; at.Parent=Lighting
local cc=Instance.new("ColorCorrectionEffect"); cc.Brightness=0.015; cc.Contrast=0.09; cc.Saturation=0.08; cc.TintColor=Color3.fromRGB(255,244,229); cc.Parent=Lighting
local bloom=Instance.new("BloomEffect"); bloom.Intensity=0.16; bloom.Size=28; bloom.Threshold=1.12; bloom.Parent=Lighting
local rays=Instance.new("SunRaysEffect"); rays.Intensity=0.075; rays.Spread=0.78; rays.Parent=Lighting
local clouds=Instance.new("Clouds"); clouds.Cover=0.42; clouds.Density=0.55; clouds.Color=Color3.fromRGB(220,230,239); clouds.Parent=Workspace.Terrain
Terrain.WaterColor=Color3.fromRGB(12,78,105); Terrain.WaterTransparency=0.22; Terrain.WaterReflectance=0.18; Terrain.WaterWaveSize=0.22; Terrain.WaterWaveSpeed=9
Terrain:Clear()
-- Keep players safe while the terrain voxel field is being generated.
local safePad=Instance.new("Part"); safePad.Name="BuildSafetyPad"; safePad.Anchored=true; safePad.Size=Vector3.new(160,4,160); safePad.Position=Vector3.new(0,46,0); safePad.Material=Enum.Material.Grass; safePad.Color=Color3.fromRGB(83,112,67); safePad.Parent=Workspace
local tempSpawn=Instance.new("SpawnLocation"); tempSpawn.Name="BuildSafetySpawn"; tempSpawn.Anchored=true; tempSpawn.Neutral=true; tempSpawn.Size=Vector3.new(8,1,8); tempSpawn.Position=Vector3.new(0,49,0); tempSpawn.Transparency=1; tempSpawn.Parent=Workspace
local old=Workspace:FindFirstChild("HIGHLANDS_Generated"); if old then old:Destroy() end
local decor=Instance.new("Folder"); decor.Name="HIGHLANDS_Generated"; decor.Parent=Workspace

local function sample(x,z)
 local broad=math.noise(x*0.0019,z*0.0019,CFG.seed)*0.58
 local ridge=1-math.abs(math.noise(x*0.0042,z*0.0042,CFG.seed+10)); ridge=(ridge*2-1)*0.25
 local detail=math.noise(x*0.012,z*0.012,CFG.seed+20)*0.075
 local basin=math.clamp(1-(x*x+z*z)/(CFG.radius*CFG.radius*1.6),0,1)
 local h=CFG.sea+19+broad*116+ridge*75+detail*28+basin*13
 -- sharp alpine crown to the north, broad green foothills at spawn
 local crown=math.exp(-((x-80)^2/90000+(z+230)^2/120000))*90
 h=h+crown
 return math.floor(math.clamp(h,CFG.sea-16,212)/4+0.5)*4
end
local function surfaceMaterial(x,z,h)
 if h<=CFG.sea+3 then return Enum.Material.Sand end
 if h>CFG.sea+112 then return Enum.Material.Snow end
 if h>CFG.sea+72 then return Enum.Material.Rock end
 if math.noise(x*0.008,z*0.008,CFG.seed+43)>0.58 then return Enum.Material.LeafyGrass end
 if math.noise(x*0.02,z*0.02,CFG.seed+53)>0.78 then return Enum.Material.Ground end
 return Enum.Material.Grass
end

-- 4-stud voxel heightfield, filled in one terrain write rather than thousands of FillBlock calls.
local n=CFG.radius*2/CFG.step
local nx=n; local nz=n; local ny=65
local mats=table.create(nx); local occ=table.create(nx)
for ix=1,nx do mats[ix]=table.create(ny); occ[ix]=table.create(ny); for iy=1,ny do mats[ix][iy]=table.create(nz,Enum.Material.Air); occ[ix][iy]=table.create(nz,0) end end
for ix=1,nx do
 local x=-CFG.radius+(ix-0.5)*CFG.step
 for iz=1,nz do
  local z=-CFG.radius+(iz-0.5)*CFG.step
  local h=sample(x,z); local top=math.clamp(math.floor((h-CFG.bottom)/4)+1,1,ny)
  local surf=surfaceMaterial(x,z,h)
  for iy=1,top do
   local y=CFG.bottom+(iy-0.5)*4
   local m=Enum.Material.Rock
   if y>h-7 then m=surf elseif y>h-24 then m=(surf==Enum.Material.Snow and Enum.Material.Rock or Enum.Material.Ground) end
   mats[ix][iy][iz]=m; occ[ix][iy][iz]=1
  end
 end
 if ix%12==0 then task.wait() end
end
local region=Region3.new(Vector3.new(-CFG.radius,CFG.bottom,-CFG.radius),Vector3.new(CFG.radius,CFG.bottom+ny*4,CFG.radius)):ExpandToGrid(4)
Terrain:WriteVoxels(region,4,mats,occ)
safePad:Destroy(); tempSpawn:Destroy()

-- Scenic river gorge through east valley; water follows terrain contours.
for i=0,48 do
 local z=-190+i*8; local x=190+math.sin(i*0.18)*23; local y=sample(x,z)-5
 if y>CFG.sea+2 then Terrain:FillBall(Vector3.new(x,y,z),10,Enum.Material.Air); Terrain:FillBall(Vector3.new(x,y-7,z),7,Enum.Material.Water) end
end
-- curated forest on foothills: low part count, varied silhouettes and natural spacing
local function tree(x,z,scale)
 local h=sample(x,z); if h<CFG.sea+8 or h>CFG.sea+88 then return end
 local model=Instance.new("Model"); model.Name="AlpineFir"; model.Parent=decor
 local trunk=Instance.new("Part"); trunk.Name="Trunk"; trunk.Anchored=true; trunk.CanCollide=true; trunk.Shape=Enum.PartType.Cylinder
 local th=14*scale; trunk.Size=Vector3.new(2.4*scale,th,2.4*scale); trunk.CFrame=CFrame.new(x,h+th/2,z)*CFrame.Angles(0,0,math.pi/2); trunk.Material=Enum.Material.Wood; trunk.Color=Color3.fromRGB(92,68,48); trunk.Parent=model
 local tiers=3
 for t=1,tiers do
  local leaf=Instance.new("Part"); leaf.Name="FirCanopy"; leaf.Anchored=true; leaf.CanCollide=false; leaf.Shape=Enum.PartType.Ball
  local wid=(12-(t-1)*2.5)*scale; local high=10*scale; leaf.Size=Vector3.new(wid,high,wid); leaf.CFrame=CFrame.new(x,h+th-2*scale+(t-1)*5*scale,z); leaf.Material=Enum.Material.LeafyGrass
  local variation=rng:NextInteger(-12,12); leaf.Color=Color3.fromRGB(48+variation,105+variation,68+variation); leaf.Parent=model
 end
end
for i=1,205 do
 local a=rng:NextNumber()*math.pi*2; local r=math.sqrt(rng:NextNumber())*225
 local x=math.cos(a)*r; local z=math.sin(a)*r
 if math.noise(x*0.005,z*0.005,CFG.seed+90)>-0.05 and (x*x+z*z)>3600 then tree(x,z,rng:NextNumber(0.78,1.35)) end
 if i%25==0 then task.wait() end
end
-- Landmark: small overlook deck, warm lanterns, and a readable spawn clearing.
local function part(name,size,cf,mat,color,parent)
 local p=Instance.new("Part"); p.Name=name;p.Size=size;p.CFrame=cf;p.Anchored=true;p.Material=mat;p.Color=color;p.Parent=parent;return p
end
local clearing=Instance.new("Folder");clearing.Name="LookoutAndTrailhead";clearing.Parent=decor
local sy=sample(0,0)+1
part("LookoutDeck",Vector3.new(34,2,26),CFrame.new(0,sy+1,0),Enum.Material.WoodPlanks,Color3.fromRGB(105,78,54),clearing)
for _,x in ipairs({-15,15}) do for _,z in ipairs({-11,11}) do part("TimberPost",Vector3.new(1.5,9,1.5),CFrame.new(x,sy+6,z),Enum.Material.Wood,Color3.fromRGB(82,61,45),clearing) end end
part("RidgeTrail",Vector3.new(8,0.5,250),CFrame.new(0,sy+0.2,-135),Enum.Material.Ground,Color3.fromRGB(104,91,69),clearing)
-- Compact mountain hamlet: timber cabins, stone hearths, warm windows, paths.
local village=Instance.new("Folder"); village.Name="PinewatchVillage"; village.Parent=decor
local function cabin(x,z,rot,variant)
 local ground=sample(x,z)
 local cf=CFrame.new(x,ground,z)*CFrame.Angles(0,rot,0)
 local width=variant==1 and 24 or 20
 local depth=variant==1 and 18 or 16
 local wallH=11
 local wood=variant==1 and Color3.fromRGB(115,78,50) or Color3.fromRGB(91,73,58)
 local wall=part("CabinWalls",Vector3.new(width,wallH,depth),cf*CFrame.new(0,wallH/2,0),Enum.Material.WoodPlanks,wood,village)
 part("StoneFoundation",Vector3.new(width+2,2,depth+2),cf*CFrame.new(0,1,0),Enum.Material.Slate,Color3.fromRGB(91,91,86),village)
 -- Two roof planes overhang the cabin; create a sharp ridge silhouette.
 part("RoofLeft",Vector3.new(width/2+2,1.6,depth+4),cf*CFrame.new(-width/4,wallH+3,0)*CFrame.Angles(0,0,math.rad(-34)),Enum.Material.WoodPlanks,Color3.fromRGB(55,48,43),village)
 part("RoofRight",Vector3.new(width/2+2,1.6,depth+4),cf*CFrame.new(width/4,wallH+3,0)*CFrame.Angles(0,0,math.rad(34)),Enum.Material.WoodPlanks,Color3.fromRGB(64,53,44),village)
 part("Door",Vector3.new(4.2,8,0.5),cf*CFrame.new(0,4,depth/2+0.28),Enum.Material.Wood,Color3.fromRGB(61,43,32),village)
 for _,side in ipairs({-1,1}) do
  local w=part("AmberWindow",Vector3.new(3.4,3.2,0.45),cf*CFrame.new(side*width*0.32,6,depth/2+0.3),Enum.Material.Glass,Color3.fromRGB(255,190,111),village)
  w.Transparency=0.12; local light=Instance.new("PointLight");light.Color=Color3.fromRGB(255,174,91);light.Brightness=0.45;light.Range=13;light.Parent=w
 end
 local chimney=part("StoneChimney",Vector3.new(3,10,3),cf*CFrame.new(width*0.3,wallH+5,-depth*0.2),Enum.Material.Slate,Color3.fromRGB(93,85,76),village)
 part("Porch",Vector3.new(width*0.62,1,5),cf*CFrame.new(0,0.7,depth/2+3),Enum.Material.WoodPlanks,wood,village)
end
local homes={{-73,-27,0,1},{72,-34,0.22,1},{-104,44,-0.18,2},{107,51,0.12,2},{-42,91,0.3,2},{55,105,-0.25,1},{0,145,0,2}}
for _,h in ipairs(homes) do cabin(h[1],h[2],h[3],h[4]) end
-- Village square and a timber sign make the arrival point legible.
part("VillageGreen",Vector3.new(42,0.35,34),CFrame.new(0,sample(0,42)+0.15,42),Enum.Material.Ground,Color3.fromRGB(103,94,71),village)
local sign=part("PinewatchSign",Vector3.new(12,4,0.8),CFrame.new(0,sample(0,42)+7,62),Enum.Material.WoodPlanks,Color3.fromRGB(99,67,42),village)
local signGui=Instance.new("SurfaceGui");signGui.Face=Enum.NormalId.Front;signGui.Parent=sign
local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text="PINEWATCH  •  HIGH COUNTRY";label.TextColor3=Color3.fromRGB(245,220,174);label.TextScaled=true;label.Font=Enum.Font.Garamond;label.Parent=signGui
for _,x in ipairs({-13,13}) do
 local pole=part("LanternPost",Vector3.new(0.7,9,0.7),CFrame.new(x,sy+5,5),Enum.Material.Wood,Color3.fromRGB(69,54,43),clearing)
 local lamp=part("TrailLantern",Vector3.new(1.8,1.8,1.8),CFrame.new(x,sy+9.7,5),Enum.Material.Glass,Color3.fromRGB(255,193,111),clearing);lamp.Transparency=0.12
 local light=Instance.new("PointLight");light.Color=Color3.fromRGB(255,183,96);light.Brightness=1.1;light.Range=18;light.Parent=lamp
end
-- Spawn point faces the mountain vista.
local sp=Instance.new("SpawnLocation");sp.Name="TrailheadSpawn";sp.Anchored=true;sp.Neutral=true;sp.Size=Vector3.new(8,1,8);sp.CFrame=CFrame.new(0,sy+3,12);sp.Transparency=1;sp.CanCollide=true;sp.Parent=Workspace
-- Camera-friendly intro focus for first play session.
for _,p in ipairs(Players:GetPlayers()) do if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then p.Character:PivotTo(CFrame.new(0,sy+7,22)) end end
print("HIGHLANDS built: 512x512-stud alpine valley, ridgeline, river gorge, fir forest, trailhead, Future lighting.")
]]></ProtectedString>
